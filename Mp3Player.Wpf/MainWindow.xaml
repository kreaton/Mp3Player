<Window x:Class="Mp3Player.Wpf.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Icon="app.ico"
        Width="1120" Height="760" MinWidth="940" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="{DynamicResource TextPrimary}"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>

        <!-- ============================ palette ============================ -->
        <SolidColorBrush x:Key="TextPrimary" Color="#F5F5FA"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#B4B4C4"/>
        <SolidColorBrush x:Key="TextTertiary" Color="#8A8A9C"/>
        <SolidColorBrush x:Key="CardBrush" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#30FFFFFF"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#E5484D"/>
        <SolidColorBrush x:Key="DangerDarkBrush" Color="#B4232A"/>
        <!-- Replaced at runtime from the album art (see MainWindow.xaml.cs) -->
        <SolidColorBrush x:Key="AccentBrush" Color="#8B5CF6"/>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ============================ text ============================ -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,11"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,11"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>

        <!-- ============================ cards ============================ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>

        <!-- ============================ pill buttons (text, optionally with an icon) ============================ -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Bd" CornerRadius="19"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>
                            <Border x:Name="Hover" CornerRadius="19" Background="White" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.16"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.06"/>
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentPill" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="DangerPill" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="DangerDarkPill" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="{StaticResource DangerDarkBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- ============================ round icon buttons (previous / next / play) ============================ -->
        <Style x:Key="CircleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Ellipse x:Name="Bd" Fill="{TemplateBinding Background}"/>
                            <Ellipse x:Name="Hover" Fill="White" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.FontFamily="{StaticResource IconFont}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.16"/>
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.06" ScaleY="1.06"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.06"/>
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlayCircle" TargetType="Button" BasedOn="{StaticResource CircleButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="70"/>
        </Style>

        <!-- ============================ toggle chips (shuffle / crossfade) ============================ -->
        <Style x:Key="ChipToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid x:Name="Root">
                            <Border x:Name="Bd" CornerRadius="17" Background="#1AFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"/>
                            <Border x:Name="On" CornerRadius="17" Background="{DynamicResource AccentBrush}" Opacity="0"/>
                            <Border x:Name="Hover" CornerRadius="17" Background="White" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="On" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.12"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ slider ============================ -->
        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Rectangle x:Name="E" Fill="White">
                            <Rectangle.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.55"/>
                            </Rectangle.Effect>
                        </Rectangle>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="E" Property="Fill" Value="#FFE6E6F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderFillButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent" Height="24">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentBrush}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderEmptyButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent" Height="24"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FancySlider" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                            <Border Height="4" CornerRadius="2" Background="#33FFFFFF" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFillButton}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmptyButton}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid x:Name="RootGrid" ClipToBounds="True">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF0D0D13" Offset="0"/>
                <GradientStop Color="#FF171722" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- ============================ atmosphere: blurred album art + accent glow ============================ -->
        <Image x:Name="BackdropImage" Source="{Binding CoverArt}" Stretch="UniformToFill"
               Opacity="0.42" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <ScaleTransform ScaleX="1.3" ScaleY="1.3"/>
            </Image.RenderTransform>
            <Image.Effect>
                <BlurEffect Radius="70" KernelType="Gaussian"/>
            </Image.Effect>
        </Image>
        <Ellipse Width="560" Height="560" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-190,-230,0,0" Fill="{DynamicResource AccentBrush}" Opacity="0.28" IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="130" KernelType="Gaussian"/>
            </Ellipse.Effect>
        </Ellipse>
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#55000000" Offset="0"/>
                    <GradientStop Color="#EE0A0A10" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ============================ main layer ============================ -->
        <Grid x:Name="MainLayer" Margin="28,20,28,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- top bar: open folder, path, delete buttons -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource AccentPill}" Command="{Binding OpenFolderCommand}"
                            ToolTip="Choose the folder to play (its subfolders are included)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE838;" FontSize="15" Margin="0,1,9,0"/>
                            <TextBlock Text="Open folder"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PillButton}" Margin="10,0,0,0" Click="SearchButton_Click"
                            ToolTip="Find and play a track by artist, album or title (Ctrl+F)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" FontSize="15" Margin="0,1,9,0"/>
                            <TextBlock Text="Search"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0">
                    <TextBlock Text="{Binding FolderText}" Foreground="{StaticResource TextSecondary}" FontSize="13"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding FolderText}"/>
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,6,0,0" Background="Transparent"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource DangerPill}" Command="{Binding DeleteTrackCommand}"
                        Margin="0,0,10,0"
                        ToolTip="Ask for confirmation, then skip to the next track and delete this file">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" FontSize="14" Margin="0,1,8,0"/>
                        <TextBlock Text="Delete track"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource DangerDarkPill}" Command="{Binding DeleteFolderCommand}"
                        ToolTip="Ask for confirmation, then delete the whole folder of this track (usually an album) and play the next track. Disabled for tracks directly in the opened folder.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" FontSize="14" Margin="0,1,8,0"/>
                        <TextBlock Text="Delete folder"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource PillButton}" Margin="10,0,0,0" Padding="12,9"
                        Click="AboutButton_Click" ToolTip="About MP3 Player">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE946;" FontSize="15" Margin="0,1,0,0"/>
                </Button>
            </Grid>

            <!-- content: cover + headline | details -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="390"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <Grid x:Name="CoverCard" Width="320" Height="320" HorizontalAlignment="Center">
                        <Border CornerRadius="22" Background="#FF000000">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="46" ShadowDepth="14" Direction="270" Opacity="0.6"/>
                            </Border.Effect>
                        </Border>
                        <!-- placeholder when the file has no cover art -->
                        <Border CornerRadius="22">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF2B2B3D" Offset="0"/>
                                    <GradientStop Color="#FF171724" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#x266B;" FontSize="140" Foreground="{DynamicResource AccentBrush}" Opacity="0.75"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCover}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Border CornerRadius="22" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding CoverArt}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding Heading}" FontSize="26" FontWeight="SemiBold" TextAlignment="Center"
                               TextWrapping="Wrap" MaxHeight="76" TextTrimming="CharacterEllipsis"
                               Margin="10,28,10,0"/>
                    <TextBlock Text="{Binding SubHeading}" FontSize="15" TextAlignment="Center"
                               Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"
                               Margin="10,6,10,0" ToolTip="{Binding SubHeading}"/>
                    <TextBlock Text="{Binding TrackText}" FontSize="12" TextAlignment="Center"
                               Foreground="{StaticResource TextTertiary}" Margin="10,8,10,0"/>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="20,0,0,0" Padding="30,26,30,16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="FILE" Style="{StaticResource SectionHeader}"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FileName}" Style="{StaticResource InfoValue}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Folder" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FolderPath}" Style="{StaticResource InfoValue}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Details" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Details}" Style="{StaticResource InfoValue}"/>
                            </Grid>

                            <TextBlock Text="TAG INFO" Style="{StaticResource SectionHeader}" Margin="0,8,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Title" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Title}" Style="{StaticResource InfoValue}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Artist" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Artist}" Style="{StaticResource InfoValue}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Album" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Album}" Style="{StaticResource InfoValue}"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Year" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Year}" Style="{StaticResource InfoValue}"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Track" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TrackNo}" Style="{StaticResource InfoValue}"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Genre" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Genre}" Style="{StaticResource InfoValue}"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Comment" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Comment}" Style="{StaticResource InfoValue}"
                                           TextWrapping="Wrap" TextTrimming="None" MaxHeight="110"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- transport card -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,20,0,0" Padding="26,16,26,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- position -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="52"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding PositionText}" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        <Slider x:Name="SeekSlider" Grid.Column="1" Style="{StaticResource FancySlider}"
                                Minimum="0" Maximum="{Binding DurationSeconds}"
                                Value="{Binding PositionSeconds, Mode=OneWay}"
                                SmallChange="5" LargeChange="15"
                                IsEnabled="{Binding IsSeekable}"/>
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="12" TextAlignment="Right"
                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- controls -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton Style="{StaticResource ChipToggle}" IsChecked="{Binding Shuffle, Mode=TwoWay}"
                                          ToolTip="Play every track once in random order before any track repeats (S)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B1;" Margin="0,1,8,0"/>
                                    <TextBlock Text="Shuffle"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource ChipToggle}" Margin="10,0,0,0"
                                          IsChecked="{Binding CrossfadeEnabled, Mode=TwoWay}"
                                          ToolTip="Fade the end of a track into the start of the next">
                                <TextBlock Text="Crossfade"/>
                            </ToggleButton>
                            <Slider Style="{StaticResource FancySlider}" Width="108" Margin="12,0,0,0"
                                    Minimum="1" Maximum="18" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding CrossfadeSeconds, Mode=TwoWay}"
                                    IsEnabled="{Binding CrossfadeEnabled}"/>
                            <TextBlock Text="{Binding CrossfadeSeconds, StringFormat={}{0:0} s}" Width="30" Margin="8,0,0,0"
                                       VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource CircleButton}" Content="&#xE892;" Command="{Binding PreviousCommand}"
                                    ToolTip="Previous (Ctrl+Left; restarts the track after 3 seconds)"/>
                            <Grid Margin="14,0">
                                <Ellipse Width="70" Height="70" Fill="{DynamicResource AccentBrush}" Opacity="0.6" IsHitTestVisible="False">
                                    <Ellipse.Effect>
                                        <BlurEffect Radius="26" KernelType="Gaussian"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Button Style="{StaticResource PlayCircle}" Content="{Binding PlayPauseGlyph}"
                                        Command="{Binding PlayPauseCommand}" ToolTip="{Binding PlayPauseTip}"/>
                            </Grid>
                            <Button Style="{StaticResource CircleButton}" Content="&#xE893;" Command="{Binding NextCommand}"
                                    ToolTip="Next (Ctrl+Right)"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE767;" FontSize="16"
                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Slider Style="{StaticResource FancySlider}" Width="140" Minimum="0" Maximum="100"
                                    SmallChange="2" LargeChange="10" Value="{Binding Volume, Mode=TwoWay}"/>
                            <TextBlock Text="{Binding Volume, StringFormat={}{0:0}%}" Width="44" TextAlignment="Right"
                                       VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- status | version -->
            <Grid Grid.Row="3" Margin="6,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" FontSize="12"
                           Foreground="{StaticResource TextTertiary}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="VersionText" Grid.Column="1" FontSize="12" Margin="16,0,0,0"
                           Foreground="{StaticResource TextTertiary}"/>
            </Grid>
        </Grid>

        <!-- ============================ confirmation card (modal overlay) ============================ -->
        <Grid x:Name="Overlay" Background="#B2000000" Visibility="Collapsed">
            <Border Width="500" CornerRadius="18" Background="#FF22222E" BorderBrush="#40FFFFFF" BorderThickness="1"
                    Padding="30,26,30,24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="50" ShadowDepth="14" Direction="270" Opacity="0.7"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DialogMessage" Margin="0,12,0,0" FontSize="14" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondary}"/>
                    <Border x:Name="DialogDetailBox" Margin="0,16,0,0" Padding="12,10" CornerRadius="10" Background="#22FFFFFF">
                        <TextBlock x:Name="DialogDetail" FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button x:Name="CancelButton" Style="{StaticResource PillButton}" Content="Cancel"
                                MinWidth="104" Click="CancelButton_Click"/>
                        <Button x:Name="ConfirmButton" Style="{StaticResource DangerPill}" Content="Delete"
                                MinWidth="124" Margin="10,0,0,0" Click="ConfirmButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================ search card (overlay; click outside or Esc closes it) ============================ -->
        <Grid x:Name="SearchOverlay" Background="#B2000000" Visibility="Collapsed"
              MouseLeftButtonDown="SearchOverlay_MouseLeftButtonDown">
            <Border Width="640" CornerRadius="18" Background="#FF22222E" BorderBrush="#40FFFFFF" BorderThickness="1"
                    Padding="26,24,26,22" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonDown="Card_MouseLeftButtonDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="50" ShadowDepth="14" Direction="270" Opacity="0.7"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Find a track" FontSize="21" FontWeight="SemiBold"/>
                    <TextBox x:Name="SearchBox" Margin="0,14,0,0" FontSize="15" TextChanged="SearchBox_TextChanged"
                             ToolTip="Type any part of the artist, album or song title"/>
                    <TextBlock x:Name="SearchHint" Margin="2,8,0,8" FontSize="12" Foreground="{StaticResource TextTertiary}"/>
                    <ListBox x:Name="SearchList" Height="340" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" MouseDoubleClick="SearchList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,3">
                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="14" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="{Binding DisplaySubtitle}" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Margin="0,14,0,0">
                        <TextBlock Text="↑ ↓ select   •   Enter play   •   Esc close" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextTertiary}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource PillButton}" Content="Close" MinWidth="96" Click="SearchClose_Click"/>
                            <Button Style="{StaticResource AccentPill}" Content="Play" MinWidth="96" Margin="10,0,0,0" Click="SearchPlay_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================ about card (overlay; click outside or Esc closes it) ============================ -->
        <Grid x:Name="AboutOverlay" Background="#B2000000" Visibility="Collapsed"
              MouseLeftButtonDown="AboutOverlay_MouseLeftButtonDown">
            <Border Width="460" CornerRadius="18" Background="#FF22222E" BorderBrush="#40FFFFFF" BorderThickness="1"
                    Padding="30,30,30,24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonDown="Card_MouseLeftButtonDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="50" ShadowDepth="14" Direction="270" Opacity="0.7"/>
                </Border.Effect>
                <StackPanel>
                    <Image x:Name="AboutIcon" Width="88" Height="88" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="AboutName" Margin="0,16,0,0" FontSize="24" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="AboutVersion" Margin="0,4,0,0" FontSize="13" HorizontalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Margin="0,14,0,0" FontSize="13.5" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{StaticResource TextSecondary}"
                               Text="Plays every MP3 in a folder and its subfolders, with shuffle, crossfade and quick clean-up of tracks and albums."/>

                    <Border Margin="0,20,0,0" Padding="16,12" CornerRadius="10" Background="#22FFFFFF">
                        <StackPanel>
                            <TextBlock Text="CREDITS" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                            <TextBlock FontSize="12.5" TextWrapping="Wrap" LineHeight="21">
                                <Run Text="Made by Per Hejndorf, with Claude (Anthropic)"/>
                                <LineBreak/>
                                <Run Text="Audio:" Foreground="{StaticResource TextSecondary}"/>
                                <Hyperlink NavigateUri="https://github.com/naudio/NAudio" RequestNavigate="Link_RequestNavigate"
                                           Foreground="{StaticResource TextPrimary}">NAudio</Hyperlink>
                                <Run Text="by Mark Heath (MIT)" Foreground="{StaticResource TextSecondary}"/>
                                <LineBreak/>
                                <Run Text="Tags:" Foreground="{StaticResource TextSecondary}"/>
                                <Hyperlink NavigateUri="https://github.com/mono/taglib-sharp" RequestNavigate="Link_RequestNavigate"
                                           Foreground="{StaticResource TextPrimary}">TagLibSharp</Hyperlink>
                                <Run Text="(LGPL-2.1)" Foreground="{StaticResource TextSecondary}"/>
                                <LineBreak/>
                                <Run Text="Icons: Segoe Fluent Icons by Microsoft" Foreground="{StaticResource TextSecondary}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,18,0,0" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextTertiary}" Text="© 2026 Per Hejndorf"/>
                    <Button x:Name="AboutCloseButton" Style="{StaticResource AccentPill}" Content="Close"
                            MinWidth="110" Margin="0,18,0,0" HorizontalAlignment="Center" Click="AboutClose_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
